# Willow environment variables
# ─────────────────────────────────────────────────────────────────
# Copy to web/.env.local and fill in values:
#   cp config/env.example .env.local
#
# OR, if you don't use Vercel right now:
#   - set AI_GATEWAY_API_KEY to a key you generated at
#     https://vercel.com/dashboard → AI → Gateway → API Keys
# ─────────────────────────────────────────────────────────────────


# ── AI Gateway (one of the two below is required) ──

# Recommended: short-lived OIDC token. Provisioned automatically by
# `vercel env pull`. You normally do not edit this by hand.
# VERCEL_OIDC_TOKEN=

# Alternative: long-lived API key. Use only if you can't run
# `vercel env pull` (CI environments, non-Vercel hosts).
# AI_GATEWAY_API_KEY=


# ── CBT companion (Neon + Auth.js + RAG) ──
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# AUTH_SECRET=          # openssl rand -base64 32
# AUTH_URL=http://localhost:3000   # production: https://willowspace.dev
#
# VOYAGE_API_KEY=       # voyage-3-large + rerank-2 (direct API). Optional if VERCEL_OIDC_TOKEN / AI_GATEWAY_API_KEY is set — embeddings work via AI Gateway; rerank needs this key.
#
# Optional: Upstash (Vercel KV REST) — chat + auth rate limits
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
#
# Optional: Vercel Blob — `npm run ingest` uploads the PDF when set
# BLOB_READ_WRITE_TOKEN=
#
# Required to enable POST /api/chat/complete (n8n / external automation).
# Send as `Authorization: Bearer <secret>` or `x-api-key`. Unset = endpoint disabled.
# Generate: openssl rand -hex 32
# CHAT_COMPLETE_SECRET=
#
# Optional: Vercel Queues — batch embedding fan-out (topic: "embeddings")
# QUEUE_TOPIC=embeddings
#
# Optional: Vercel Cron — protects /api/cron/* routes. Generate: openssl rand -hex 32
# CRON_SECRET=
#
# PERSONALIZATION_ENABLED=false   # disable memory recall, tools, summarization
#
# Optional: newline-separated admin emails for `/admin/safety`
# ADMIN_EMAILS=reviewer@example.com

# ── Email (Resend — verification + password reset) ───────────────────────────
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=onboarding@resend.dev
# APP_URL=http://localhost:3000

# ── Voice (TTS) — not implemented; see docs/developer/technology-stack-and-costs.md ──
# Future: openai/tts-1 via AI Gateway for read-aloud of assistant replies
