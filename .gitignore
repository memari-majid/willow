# Repo root — only README.md lives here; the app is under web/

# dependencies
web/node_modules
web/.pnp
web/.pnp.*
web/.yarn/*
!web/.yarn/patches
!web/.yarn/plugins
!web/.yarn/releases
!web/.yarn/versions

# testing
web/coverage

# next.js
web/.next/
web/out/

# production
web/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
web/.env*
!web/config/env.example

# vercel
web/.vercel

# typescript
web/*.tsbuildinfo
web/next-env.d.ts

# source PDFs
web/content/source-pdf/*.pdf
/*.pdf

# only README.md at repo root
/*.md
!/README.md
